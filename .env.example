NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test-mode values. Keep the secret and webhook secret server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Server-only document sync credentials. Never prefix these with NEXT_PUBLIC_.
# Generate DOCUMENT_SYNC_ENCRYPTION_KEY with: openssl rand -base64 32
SUPABASE_SECRET_KEY=
DOCUMENT_SYNC_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Server-only supplier credentials. Never prefix these with NEXT_PUBLIC_.
# Lowe's supplies the API URL and credentials after Product Discovery approval.
LOWES_PRODUCT_DISCOVERY_API_URL=
LOWES_PRODUCT_DISCOVERY_CLIENT_ID=
LOWES_PRODUCT_DISCOVERY_CLIENT_SECRET=

# Home Depot supplies the product feed through its Impact affiliate program.
HOME_DEPOT_PRODUCT_FEED_URL=
HOME_DEPOT_IMPACT_PID=

# Signs the per-call URL handed to a voice model, which is what says who that
# model may book for. Without it /api/mcp answers 503 and no URL can be minted.
# Generate with: openssl rand -base64 32
MCP_SESSION_SECRET=
# Optional second lock. If set, an MCP caller must also present it as a bearer
# token; leave empty to rely on the signed URL alone.
MCP_BEARER_TOKEN=
