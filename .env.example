NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test-mode values. Keep the secret and webhook secret server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Server-only document sync credentials. Never prefix these with NEXT_PUBLIC_.
# Generate DOCUMENT_SYNC_ENCRYPTION_KEY with: openssl rand -base64 32
SUPABASE_SECRET_KEY=
DOCUMENT_SYNC_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Server-only supplier credentials. Never prefix these with NEXT_PUBLIC_.
# Lowe's supplies the API URL and credentials after Product Discovery approval.
LOWES_PRODUCT_DISCOVERY_API_URL=
LOWES_PRODUCT_DISCOVERY_CLIENT_ID=
LOWES_PRODUCT_DISCOVERY_CLIENT_SECRET=

# Home Depot supplies the product feed through its Impact affiliate program.
HOME_DEPOT_PRODUCT_FEED_URL=
HOME_DEPOT_IMPACT_PID=

# Signs the per-call URL handed to a voice model, which is what says who that
# model may book for. Without it /api/mcp answers 503 and no URL can be minted.
# Generate with: openssl rand -base64 32
MCP_SESSION_SECRET=
# Optional second lock. If set, an MCP caller must also present it as a bearer
# token; leave empty to rely on the signed URL alone.
MCP_BEARER_TOKEN=

# Grok answers the phone over a SIP trunk. XAI_WEBHOOK_SECRET is returned once
# when the number is registered — without it /api/xai/voice refuses every call
# rather than trusting an unsigned one. The API key is also needed by
# scripts/xai-voice-worker.mjs, which holds the call's WebSocket open.
XAI_API_KEY=
XAI_WEBHOOK_SECRET=
# Where a caller is transferred when they ask for a person.
ESCALATION_PHONE_NUMBER=
# Fallbacks only. Each business sets its own booking alerts at
# /settings/notifications, and those win — one deployment serves many
# electricians, so a value here would page the wrong one. These cover a tenant
# that has not filled the form in yet.
#
# Who gets a text when a booking lands without them. Falls back to
# ESCALATION_PHONE_NUMBER when unset.
OWNER_NOTIFICATION_PHONE=
# Where the owner's copy of a booking is emailed. While A2P blocks outbound
# texts this is the only notification that actually arrives, so it carries the
# whole job: window, address, phone, and every intake answer.
OWNER_NOTIFICATION_EMAIL=

# Emailed booking confirmations, for callers who give an address. Without these
# the email is skipped and the text confirmation still goes out.
# BOOKING_EMAIL_FROM must be on a domain verified with the provider.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
