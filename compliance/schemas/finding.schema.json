{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "volteira/compliance/finding.schema.json",
  "title": "Compliance finding",
  "description": "The assessed status of one requirement in one audit. GREEN requires evidence beyond the existence of code, a comment, a policy statement, an untested setting or an automated scan alone.",
  "type": "object",
  "required": ["finding_id", "requirement_id", "audit_id", "status", "severity", "confidence", "expected", "actual", "evidence", "remediation", "legal_review_required"],
  "additionalProperties": false,
  "properties": {
    "finding_id": { "type": "string", "pattern": "^F-[A-Z0-9-]+$" },
    "requirement_id": { "type": "string" },
    "audit_id": { "type": "string" },
    "target": { "type": "string", "description": "Application name or website domain." },
    "status": { "enum": ["GREEN", "YELLOW", "RED", "GRAY", "BLUE"] },
    "status_reason": { "type": "string", "description": "Required for GRAY (why not applicable) and BLUE (what is missing)." },
    "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "applicability": { "type": "string" },
    "responsible_party": { "type": "string" },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "affected_files": { "type": "array", "items": { "type": "string", "description": "path:line" } },
    "affected_pages": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "location"],
        "properties": {
          "type": { "enum": ["source-reference", "test-result", "database-check", "config", "screenshot", "network-observation", "http-headers", "rendered-document", "official-source", "license-record", "reproduction-steps"] },
          "location": { "type": "string" },
          "collected_at": { "type": "string" },
          "method": { "type": "string" },
          "limitations": { "type": "string" }
        }
      }
    },
    "test_ids": { "type": "array", "items": { "type": "string" } },
    "test_result": { "enum": ["passed", "failed", "not-run", "skipped", "not-applicable"] },
    "remediation": { "type": "string" },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "none"] },
    "legal_review_required": { "type": "boolean" }
  }
}
